  <DataSources>
    <DataSource Name="DataSource1">
      <rd:SecurityType>DataBase</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQLAZURE</DataProvider>
        <ConnectString>Data Source=desktop5l53321sqlexpress1.database.windows.net;Initial Catalog=TeamEventPlannerDb;Encrypt=true;TrustServerCertificate=true;</ConnectString>
        <UserName>PranalDB</UserName>
        <PassWord>Pranal@1516</PassWord>
      </ConnectionProperties>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT 
              e.Id AS EventId,
              e.Name AS EventName,
              e.StartTimeUtc AS StartTime,
              e.EndTimeUtc AS EndTime,
              e.Venue,
              a.Name AS AttendeeName,
              a.Email AS AttendeeEmail
          FROM dbo.Events e
          LEFT JOIN dbo.Attendees a ON e.Id = a.EventId
         
</CommandText>
      </Query>
      <Fields>
        <Field Name="EventId">
          <DataField>EventId</DataField>
          <rd:TypeName>System.Guid</rd:TypeName>
        </Field>
        <Field Name="EventName">
          <DataField>EventName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="StartTime">
          <DataField>StartTime</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="EndTime">
          <DataField>EndTime</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Venue">
          <DataField>Venue</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AttendeeName">
          <DataField>AttendeeName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AttendeeEmail">
          <DataField>AttendeeEmail</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
